# Production Environment Variables for Vercel Deployment

# ==================== FRONTEND ====================
NEXT_PUBLIC_API_URL=https://your-vercel-app.vercel.app/api
NEXT_PUBLIC_CHAT_SERVICE_URL=https://your-vercel-app.vercel.app/api
NEXT_PUBLIC_PRODUCT_SERVICE_URL=https://your-vercel-app.vercel.app/api
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_KEY_HERE
NEXT_PUBLIC_WHATSAPP_NUMBER=+923001234567

# ==================== DATABASE ====================
DATABASE_URL=postgresql://your_user:your_password@your-host.neon.tech/learnflow

# ==================== AI & EXTERNAL APIs ====================
OPENAI_API_KEY=sk-YOUR_KEY_HERE
QDRANT_HOST=your-qdrant-host.com
QDRANT_PORT=6333

# ==================== PAYMENT ====================
STRIPE_SECRET_KEY=sk_live_YOUR_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_KEY_HERE

# ==================== SECURITY ====================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ==================== SERVICE CONFIG ====================
ENVIRONMENT=production
DEBUG=false
CORS_ORIGINS=https://your-vercel-app.vercel.app
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40

# ==================== LOGGING ====================
LOG_LEVEL=INFO
